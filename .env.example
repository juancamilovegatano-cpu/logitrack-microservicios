# =============================================================================
# LogiTrack — variables de entorno (copiar a .env)
# =============================================================================
# El compose lee .env de la raíz de este repo. Sin .env todo funciona con los
# valores por defecto de abajo: la demo arranca sin configurar nada. Copia
# este archivo solo si quieres cambiar algo.
#
#   cp .env.example .env
#
# OJO: PostgreSQL solo aplica POSTGRES_PASSWORD al CREAR la base (primer
# arranque con el volumen vacío). Si cambias la contraseña sobre un volumen
# existente, recrea el volumen o cambia también la contraseña dentro.
# =============================================================================

# Contraseña de los cinco PostgreSQL; los DATABASE_URL de los servicios la
# leen de aquí también. Por defecto logitrack, como siempre.
POSTGRES_PASSWORD=logitrack

# API keys de la ingesta de telemetría (tracking-service), lista JSON.
# Si quedara vacía y ENTORNO no es de desarrollo, el servicio NO arranca:
# un control de seguridad que existe pero está desconectado es peor que no
# tenerlo. Sustituye la clave de demostración si expones el servicio.
API_KEYS=["demo-logitrack"]
